<Window x:Class="IPCE.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IPCE.Desktop.Views"
        Title="IPCE 测量与光谱积分"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#E8EDF1">
    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="#263238"
                Padding="10,6">
            <TextBlock Foreground="White"
                       Text="{Binding StartupStatusMessage}" />
        </Border>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="350" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:WorkflowControls x:Name="WorkflowPanel"
                                    Grid.Column="0" />
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          Background="#90A4AE" />
            <views:ResultTabs x:Name="ResultsPanel"
                              Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
