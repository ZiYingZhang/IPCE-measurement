<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:input="clr-namespace:IPCE.Desktop.Input">
    <input:FiniteDoubleConverter x:Key="FiniteDoubleConverter" />
    <SolidColorBrush x:Key="AccentBrush" Color="#246B8E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F4F7F9" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5E6B73" />
    <BooleanToVisibilityConverter
        x:Key="BooleanToVisibilityConverter" />
    <Style x:Key="CoverageMessageStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="3,4,3,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground"
                Value="{StaticResource MutedTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCoverageValid}"
                         Value="True">
                <Setter Property="Foreground" Value="#2E7D32" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCoverageValid}"
                         Value="False">
                <Setter Property="Foreground" Value="#C62828" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self},
                                        Path=(Validation.Errors)[0].ErrorContent}" />
                <Setter Property="BorderBrush" Value="#C62828" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>
</ResourceDictionary>
