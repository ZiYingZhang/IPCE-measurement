<UserControl x:Class="IPCE.Desktop.Views.Plots.IpcePlotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plots="clr-namespace:IPCE.Desktop.Views.Plots"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border HorizontalAlignment="Left" Margin="4" Padding="8,3"
                Background="#E3F2FD" CornerRadius="10">
            <TextBlock x:Name="SourceBadge" Foreground="#0D47A1" />
        </Border>
        <scottPlot:WpfPlot x:Name="PlotSurface" Grid.Row="1" MinHeight="280"
                          MouseMove="PlotSurface_MouseMove"
                          MouseLeave="PlotSurface_MouseLeave" />
        <TextBlock x:Name="EmptyMessage" Grid.Row="1"
                   FontFamily="Arial"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#607D8B" FontSize="15" />
        <Border Grid.Row="1" Margin="12" Padding="9,6"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F2FFFFFF" BorderBrush="#455A64"
                BorderThickness="1" CornerRadius="4"
                IsHitTestVisible="False">
            <TextBlock x:Name="HoverText" FontFamily="{Binding Localization[Font.Family]}"
                       FontSize="14" Foreground="#263238"
                       Visibility="Collapsed" />
        </Border>
        <TextBlock x:Name="ClippedText" Grid.Row="2" Margin="5"
                   FontFamily="{Binding Localization[Font.Family]}" FontSize="14"
                   Foreground="#C62828" Visibility="Collapsed" />
        <plots:PlotToolbar x:Name="Toolbar" Grid.Row="3" />
    </Grid>
</UserControl>
