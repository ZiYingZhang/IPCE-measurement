<UserControl x:Class="IPCE.Desktop.Views.ResultTabs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:plots="clr-namespace:IPCE.Desktop.Views.Plots">
    <Border Background="White" BorderBrush="#B0BEC5" BorderThickness="1">
        <TabControl x:Name="ResultTabControl">
            <TabItem Header="i-t 轨迹">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <plots:TracePlotView x:Name="SiliconTraceView" />
                    <plots:TracePlotView x:Name="SampleTraceView"
                                         Grid.Column="1" />
                </Grid>
            </TabItem>
            <TabItem Header="时间调度">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <plots:SchedulePlotView x:Name="SchedulePlotView" />
                    <Expander Grid.Row="1" Header="锚点表（可编辑）"
                              IsExpanded="False">
                        <Grid Height="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="硅锚点">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom"
                                                Orientation="Horizontal">
                                        <Button Content="添加"
                                                Click="AddSiliconAnchor_Click" />
                                        <Button x:Name="ApplySiliconAnchorsButton"
                                                Content="应用更改"
                                                Click="ApplySiliconAnchors_Click" />
                                        <Button Content="删除所选"
                                                Click="DeleteSiliconAnchor_Click" />
                                    </StackPanel>
                                    <DataGrid x:Name="SiliconAnchorGrid"
                                              IsReadOnly="False"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding Silicon.EditableAnchors}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="波长 (nm)"
                                                Binding="{Binding WavelengthNm,
                                                    Converter={StaticResource FiniteDoubleConverter},
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnExceptions=True,
                                                    NotifyOnValidationError=True}" />
                                            <DataGridTextColumn Header="确认时间 (s)"
                                                Binding="{Binding ConfirmedTimeSeconds,
                                                    Converter={StaticResource FiniteDoubleConverter},
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnExceptions=True,
                                                    NotifyOnValidationError=True}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="样品锚点">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom"
                                                Orientation="Horizontal">
                                        <Button Content="添加"
                                                Click="AddSampleAnchor_Click" />
                                        <Button x:Name="ApplySampleAnchorsButton"
                                                Content="应用更改"
                                                Click="ApplySampleAnchors_Click" />
                                        <Button Content="删除所选"
                                                Click="DeleteSampleAnchor_Click" />
                                    </StackPanel>
                                    <DataGrid x:Name="SampleAnchorGrid"
                                              IsReadOnly="False"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding Sample.EditableAnchors}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="波长 (nm)"
                                                Binding="{Binding WavelengthNm,
                                                    Converter={StaticResource FiniteDoubleConverter},
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnExceptions=True,
                                                    NotifyOnValidationError=True}" />
                                            <DataGridTextColumn Header="确认时间 (s)"
                                                Binding="{Binding ConfirmedTimeSeconds,
                                                    Converter={StaticResource FiniteDoubleConverter},
                                                    UpdateSourceTrigger=LostFocus,
                                                    ValidatesOnExceptions=True,
                                                    NotifyOnValidationError=True}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="功率密度">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <plots:PowerDensityPlotView x:Name="PowerDensityPlotView" />
                    <Expander Grid.Row="1" Header="功率密度数据表"
                              IsExpanded="False">
                        <DataGrid Height="220" AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding Silicon.PowerDensity}" />
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="IPCE">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <plots:IpcePlotView x:Name="IpcePlotView" />
                    <Expander Grid.Row="1" Header="IPCE 数据表"
                              IsExpanded="False">
                        <Grid Height="220">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid IsReadOnly="True" AutoGenerateColumns="True"
                                      ItemsSource="{Binding Sample.CalculatedIpce}" />
                            <DataGrid Grid.Column="1" IsReadOnly="True"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding Spectrum.ExternalIpce.Points}" />
                        </Grid>
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="光谱积分">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <plots:SpectrumIntegrationPlotView
                        x:Name="SpectrumIntegrationPlotView" />
                    <Expander Grid.Row="1" Header="累计积分数据表"
                              IsExpanded="False">
                        <DataGrid Height="220" IsReadOnly="True"
                                  AutoGenerateColumns="True"
                                  ItemsSource="{Binding Spectrum.IntegrationResult.Curve}" />
                    </Expander>
                </Grid>
            </TabItem>
            <TabItem Header="结果摘要">
                <StackPanel Margin="18"
                            DataContext="{Binding Spectrum.IntegrationResult.Summary}">
                    <TextBlock FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="积分电流密度" />
                    <TextBlock Margin="0,8" FontSize="28"
                               Text="{Binding IntegratedCurrentDensityMilliamperePerSquareCentimetre,
                                              StringFormat={}{0:G8} mA cm⁻²}" />
                    <TextBlock Text="{Binding MinimumWavelengthNm,
                                              StringFormat=积分起点：{0:G8} nm}" />
                    <TextBlock Text="{Binding MaximumWavelengthNm,
                                              StringFormat=积分终点：{0:G8} nm}" />
                    <TextBlock Text="{Binding IntegratedPowerWattsPerSquareMetre,
                                              StringFormat=积分辐照功率：{0:G8} W m⁻²}" />
                    <TextBlock Text="{Binding Interpolation,
                                              StringFormat=插值：{0}}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
